# ===== Copy this file to .env and fill in real values =====
# NEVER commit .env. NEVER paste these values into chat or screenshots.

# --- Supabase ---
SUPABASE_URL=your-supabase-project-url
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-side ONLY. Never put this in frontend code.
SUPABASE_SECRET_KEY=your-secret-key

# --- Groq (AI) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=a-long-random-string

# --- Email (Gmail, optional) ---
# Leave empty to keep copy-and-send only. GMAIL_APP_PASSWORD is a Google
# "App Password" (16 letters), NOT your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Email (Resend, not used yet) ---
RESEND_API_KEY=your-resend-api-key
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret
EMAIL_FROM_ADDRESS=your-verified-sender-address

# --- Internal security ---
# Shared secret so only n8n can call the backend
N8N_BACKEND_SHARED_SECRET=a-long-random-string

# --- App ---
NODE_ENV=development
PORT=3000
# The address customers use to reach this server, e.g. https://leads.example.com
# (used for printed form links). Empty = http://localhost:<PORT>.
PUBLIC_BASE_URL=
# Websites allowed to post the intake form from a browser (comma-separated),
# e.g. https://forms.example.com. Not needed for the built-in /f/<form id> page.
INTAKE_ALLOWED_ORIGINS=
# "true" only when running behind a hosting proxy that sets X-Forwarded-For.
TRUST_PROXY=false
N8N_ENCRYPTION_KEY=a-long-random-string-generate-with-openssl
