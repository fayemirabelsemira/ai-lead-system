# Server settings. setup.sh copies this to /etc/ai-lead/env (readable only by
# root and the app). Edit it ON THE SERVER with:  sudo nano /etc/ai-lead/env
# Never commit real values. Use the same values as your laptop's .env.

NODE_ENV=production
PORT=3000
# Only Caddy (on the same server) talks to the app directly.
HOST=127.0.0.1
TRUST_PROXY=true
# Your public address, e.g. https://129-150-1-2.sslip.io  (setup.sh fills this in)
PUBLIC_BASE_URL=https://your-public-address

# --- Supabase ---
SUPABASE_URL=your-supabase-project-url
SUPABASE_SECRET_KEY=your-secret-key

# --- Groq (AI) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# --- Gmail (optional; leave empty for copy-and-send only) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Other websites allowed to post to the form API (comma-separated). Not needed
# for the built-in /f/<form id> page.
INTAKE_ALLOWED_ORIGINS=
